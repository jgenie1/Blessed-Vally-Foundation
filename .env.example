PORT=7000

# =============================================================================
# Configuration Stripe — Blessed Vally Foundation
# Obtenez vos clés sur : https://dashboard.stripe.com/apikeys
# =============================================================================

# Clé publique (côté frontend / checkout)
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_stripe

# Clé secrète (côté serveur / création des sessions de don)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe

# Secret de signature Webhook (depuis https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook_stripe

# Variables alternatives supportées pour rétrocompatibilité
BVALLEY_STRIPE_PUBLISHABLE_KEY=
BVALLEY_STRIPE_SECRET_KEY=
BVALLEY_STRIPE_WEBHOOK_SECRET=
